---
// Wraps Starlight's default footer (prev/next links, edit link, last-updated)
// and appends the studio attribution. Every docs page carries it, so the site
// states who builds Lookspan instead of leaving it anonymous.
// The stock footer reads the route from `Astro.locals.starlightRoute`; its
// Pagination destructures `pagination`, so the footer is skipped on any route
// that lacks it.
import Default from '@astrojs/starlight/components/Footer.astro';

const hasPagination = Boolean(Astro.locals.starlightRoute?.pagination);
---

{hasPagination && <Default />}

<p class="studio-note">
  Lookspan is part of <a href="https://fervon.dev">Fervon</a>, the autonomous
  software studio of Jonathan Martín — local-first developer tools built by
  fleets of AI agents.
</p>

<style>
  .studio-note {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
