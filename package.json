{
  "name": "lookspan",
  "version": "0.6.0",
  "private": true,
  "description": "Local-first observability dashboard for AI agents. MCP-native. Look at every span your agents emit.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke:cli && npm run smoke:pack",
    "migrate": "npm --workspace @lookspan/storage run migrate",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "release:cli": "npm run build && npm pack -w lookspan",
    "dev": "concurrently -n api,dashboard -c blue,magenta \"npm run dev:api\" \"npm run dev:dashboard\"",
    "dev:api": "npm --workspace @lookspan/api run dev",
    "dev:dashboard": "npm --workspace @lookspan/dashboard run dev",
    "clean": "tsc --build --clean && rimraf \"packages/*/dist\" \"apps/*/dist\"",
    "smoke:cli": "node packages/cli/scripts/bundle.mjs && node packages/cli/dist/index.js --version",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "icons": "node scripts/make-icons.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniMartin27/lookspan.git"
  },
  "keywords": [
    "ai",
    "agents",
    "observability",
    "tracing",
    "mcp",
    "langgraph",
    "crewai",
    "llm",
    "dashboard",
    "local-first"
  ],
  "author": "Jonathan Martin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JoniMartin27/lookspan/issues"
  },
  "homepage": "https://fervon.dev/lookspan/",
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.60.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
