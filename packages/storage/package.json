{
  "name": "@lookspan/storage",
  "version": "0.5.1",
  "private": true,
  "description": "Storage layer for Lookspan: schema, migrations, repositories. SQLite by default, optional Postgres.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "migrate": "tsx src/migrations.ts"
  },
  "dependencies": {
    "@lookspan/types": "*",
    "better-sqlite3": "^12.9.0",
    "pg-mem": "^3.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12"
  },
  "license": "MIT"
}
