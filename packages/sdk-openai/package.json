{
  "name": "@lookspan/openai",
  "version": "0.3.0",
  "description": "Drop-in tracing for the OpenAI SDK — wrap your client in one line and every model call becomes a Lookspan span.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@lookspan/mcp": "^0.3.0",
    "@lookspan/types": "^0.3.0"
  },
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniMartin27/lookspan.git",
    "directory": "packages/sdk-openai"
  },
  "homepage": "https://github.com/JoniMartin27/lookspan#readme",
  "keywords": [
    "openai",
    "lookspan",
    "observability",
    "tracing",
    "llm"
  ],
  "license": "MIT"
}
