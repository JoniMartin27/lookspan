{
  "name": "lookspan",
  "version": "0.5.1",
  "description": "Local-first observability dashboard for AI agents. MCP-native. Run it with one command.",
  "type": "module",
  "bin": {
    "lookspan": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "public",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "bundle": "node scripts/bundle.mjs",
    "clean": "tsc --build --clean",
    "start": "node dist/index.js",
    "prepack": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "openai": "^6.41.0",
    "pg-mem": "^3.0.5"
  },
  "devDependencies": {
    "@lookspan/api": "*",
    "@lookspan/collector": "*",
    "@lookspan/events": "*",
    "@lookspan/storage": "*",
    "@lookspan/types": "*",
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "observability",
    "tracing",
    "mcp",
    "opentelemetry",
    "llm",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniMartin27/lookspan.git",
