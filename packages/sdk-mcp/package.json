{
  "name": "@lookspan/mcp",
  "version": "0.3.0",
  "description": "Lookspan SDK for MCP — wraps any MCP client to emit spans for each tool call.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@lookspan/types": "^0.3.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniMartin27/lookspan.git",
    "directory": "packages/sdk-mcp"
  },
  "homepage": "https://github.com/JoniMartin27/lookspan#readme",
  "license": "MIT"
}
